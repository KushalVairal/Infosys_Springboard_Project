# CarbonTrack Frontend Environment Configuration
# Base URL of the Spring Boot backend REST API for direct browser requests
# Set to 'http://localhost:8080' for local dev, or leave empty ("") to use Vite dev server proxy (/api)
VITE_API_BASE_URL=http://localhost:8080

# Backend proxy target for Vite dev server proxying (used when requests target /api)
# Local development default: http://localhost:8080
# Docker compose default: http://carbontrack-backend:8080
VITE_BACKEND_PROXY_TARGET=http://localhost:8080

