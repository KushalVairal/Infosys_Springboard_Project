# CarbonTrack Backend Local Environment Variables
# Copy this file to .env in carbontrack-backend/ or the repository root and fill in your values.
# NEVER commit your actual .env file or credentials to source control.

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/carbontrack
DB_USERNAME=root
DB_PASSWORD=replace_with_local_mysql_password

# JWT Authentication Secret (minimum 32 characters / 256 bits)
JWT_SECRET=replace_with_a_long_random_secret

# Gmail SMTP Credentials (used for sending password reset OTP emails)
# For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your_gmail_address
MAIL_PASSWORD=your_new_google_app_password

# Google OAuth2 Client Configuration (for Google Sign-In)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
OAUTH2_REDIRECT_URI=http://localhost:5173/login
