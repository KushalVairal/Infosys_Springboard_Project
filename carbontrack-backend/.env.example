# CarbonTrack Backend Local Environment Variables
# Copy this file to .env in carbontrack-backend/ or the repository root and fill in your values.
# NEVER commit your actual .env file or credentials to source control.

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/carbontrack?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
DB_USERNAME=sample
DB_PASSWORD=admin@123

# JWT Authentication Secret (minimum 32 characters / 256 bits)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Gmail SMTP Credentials (used for sending password reset OTP emails)
# For Gmail, create an App Password at: https://myaccount.google.com/apppasswords
