{
  "name": "Infosys_Springboard_Project",
  "version": "1.0.0",
  "private": true,
  "description": "CarbonTrack - Spring Boot backend + React frontend",
  "scripts": {
    "setup": "npm install --prefix carbontrack-frontend",
    "dev": "npm run dev --prefix carbontrack-frontend",
    "dev:full": "concurrently -k -n backend,frontend -c yellow,cyan \"npm run backend\" \"npm run frontend:full\"",
    "frontend:full": "npm run dev --prefix carbontrack-frontend -- --mode fullstack",
    "backend": "node scripts/run-backend.js",
    "test:backend": "node scripts/run-backend.js test",
    "build": "npm run build --prefix carbontrack-frontend",
    "build:pages": "npm run build --prefix carbontrack-frontend -- --base=./",
    "predeploy": "npm run build:pages",
    "deploy": "gh-pages -d carbontrack-frontend/dist"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "gh-pages": "^6.3.0"
  }
}
