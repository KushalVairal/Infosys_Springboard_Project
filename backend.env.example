# Copy to backend.env (which is git-ignored) and fill in real values.
DB_URL=jdbc:mysql://localhost:3306/carbontrack
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MAIL_USERNAME=
MAIL_PASSWORD=
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional: GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
OAUTH2_REDIRECT_URI=http://localhost:5173/login
